{
    "name": "cacaaotesouro/cacaaotesouro",
    "description": "Sistema web Caça ao Tesouro - painel, configurações e autenticação",
    "type": "project",
    "license": "proprietary",
    "keywords": ["caça ao tesouro", "slim", "php"],
    "require": {
        "php": ">=8.1",
        "chillerlan/php-qrcode": "^5.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public",
        "dev": "php -S localhost:8080 -t public"
    },
    "config": {
        "sort-packages": true
    }
}
